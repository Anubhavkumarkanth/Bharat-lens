{
  "name": "bharat-lens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "ingest": "tsx --env-file=.env.local src/scripts/ingest.ts",
    "stats": "tsx --env-file=.env.local src/scripts/stats.ts",
    "reclassify": "tsx --env-file=.env.local src/scripts/reclassify.ts",
    "recluster": "tsx --env-file=.env.local src/scripts/recluster.ts",
    "resummarize": "tsx --env-file=.env.local src/scripts/resummarize.ts",
    "decode-entities": "tsx --env-file=.env.local src/scripts/decode-entities.ts",
    "debug-source": "tsx --env-file=.env.local src/scripts/debug-source.ts",
    "test:classify": "tsx src/scripts/test-classify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@mozilla/readability": "^0.6.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "linkedom": "^0.18.13",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "description": "India-first news reader: 17 wire and print sources, deduplicated across outlets, with grounded two-sentence summaries in English and Hindi.",
  "license": "MIT",
  "author": "Anubhav Kumar",
  "keywords": [
    "news",
    "india",
    "nextjs",
    "typescript",
    "postgres",
    "rss",
    "aggregator"
  ]
}

# Copy to .env.local for local runs. On Vercel, add the same names under
# Project Settings > Environment Variables.

# Required. On Supabase: Connect > Connection string > "Transaction pooler" (port 6543).
DATABASE_URL=

# Protects /api/cron/ingest. Any long random string, e.g. `openssl rand -hex 32`.
# Vercel's cron sends it automatically once it's set.
CRON_SECRET=

# Optional: summaries and Hindi translation. Free key at https://aistudio.google.com
GEMINI_API_KEY=

# Optional alternative to Gemini.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini
